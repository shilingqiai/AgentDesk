# ============================================================
# 模型配置 — 阿里云 DashScope (百炼平台)
#
# 使用 OpenAI 兼容接口：
#   base_url = https://dashscope.aliyuncs.com/compatible-mode/v1
#   api_key = DASHSCOPE_API_KEY
#
# 模型列表参考：https://help.aliyun.com/document_detail/2712195.html
# ============================================================

# 大语言模型（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 路由/分类模型（可选，默认使用 LLM_MODEL）
ROUTER_MODEL=qwen-mt-flash

# Embedding 模型（必填）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================
# 数据库
# ============================================================
DATABASE_URL=sqlite:///./data/ticket_dispatch.db

# ============================================================
# 飞书/Lark 集成（可选）
#
# 1. 前往飞书开放平台 https://open.feishu.cn/app 创建企业自建应用
# 2. 获取 App ID + App Secret（凭证与基础信息页面）
# 3. 启用机器人能力（添加应用能力 → 机器人）
# 4. 配置事件订阅（请求网址: https://your-domain.com/feishu/event）
#    - 订阅事件: im.message.receive_v1（接收消息）
# ============================================================
# FEISHU_APP_ID=cli_xxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret_here
# FEISHU_VERIFICATION_TOKEN=your_verification_token_here
# FEISHU_ENCRYPT_KEY=your_encrypt_key_here

# ============================================================
# 应用配置
# ============================================================
DEBUG=True
LOG_LEVEL=INFO

# ============================================================
# 其他可选服务
# ============================================================
# Redis（可选，用于缓存）
# REDIS_URL=redis://localhost:6379/0

# 天气API（可选，用于环境信息展示）
# OPENWEATHER_API_KEY=your_openweather_api_key_here
